# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/genesis?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
GENESIS_BOOTSTRAP_TOKEN="replace-with-a-separate-random-token-of-at-least-32-characters"
# Required for ORACLE
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
# Optional operational settings
APP_URL="http://localhost:3000"

# Canonical public origin used to validate browser mutation requests (set behind reverse proxies).
GENESIS_APP_ORIGIN=http://localhost:3000

# Optional dated JSON pricing catalog. Leave empty to keep monetary cost unknown.
GENESIS_MODEL_PRICING_JSON=

# Optional local model provider (no API key). Plain HTTP is allowed only on loopback.
# GENESIS_AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-chat-model
# OLLAMA_EMBEDDING_MODEL=your-installed-1536-dimension-embedding-model

# Optional encrypted backup key: base64-encoded 32 random bytes (never commit the value).
# GENESIS_BACKUP_KEY=
# Local MCP stdio bridge: set the exact owner ID after local account setup.
# GENESIS_MCP_OWNER_USER_ID=

# Telegram private bot + Mini App
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_WEBAPP_URL="https://your-app.example/telegram"
GENESIS_TELEGRAM_ALLOWED_USER_ID=""
GENESIS_TELEGRAM_OWNER_USER_ID=""
