
name: GENESIS P0 hardening and verification

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  prepare:
    name: Fix configuration and generate lockfile
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Patch deployment configuration
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path

          root = Path("telegram-integration/GENESIS_4.0_FINAL/source/server")

          def replace_once(path, old, new):
              file = root / path
              text = file.read_text()
              if old not in text:
                  raise SystemExit(f"PATCH FAILED: expected text not found in {path}")
              if text.count(old) != 1:
                  raise SystemExit(f"PATCH FAILED: ambiguous match in {path}")
              file.write_text(text.replace(old, new))

          replace_once(
              "Dockerfile",
              "RUN npm install",
              "RUN npm ci"
          )

          replace_once(
              ".env.example",
              "# Required\n",
              "# Required\n"
              "POSTGRES_PASSWORD=replace-with-a-long-random-hex-password\n"
          )

          replace_once(
              "docker-compose.yml",
              "      OLLAMA_EMBEDDING_MODEL: ${OLLAMA_EMBEDDING_MODEL:-}\n",
              "      OLLAMA_EMBEDDING_MODEL: ${OLLAMA_EMBEDDING_MODEL:-}\n"
              "      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:-}\n"
              "      TELEGRAM_WEBHOOK_SECRET: ${TELEGRAM_WEBHOOK_SECRET:-}\n"
              "      TELEGRAM_WEBAPP_URL: ${TELEGRAM_WEBAPP_URL:-}\n"
              "      GENESIS_TELEGRAM_ALLOWED_USER_ID: ${GENESIS_TELEGRAM_ALLOWED_USER_ID:-}\n"
              "      GENESIS_TELEGRAM_OWNER_USER_ID: ${GENESIS_TELEGRAM_OWNER_USER_ID:-}\n"
          )

          webhook = "app/api/telegram/webhook/route.ts"

          replace_once(
              webhook,
              "if(!r.ok)throw new Error(`Telegram ${method} failed`);return r.json();",
              "const result=await r.json() as {ok?:boolean};"
              "if(!r.ok||result.ok!==true)throw new Error(`Telegram ${method} failed`);"
              "return result;"
          )

          replace_once(
              webhook,
              "}catch{return NextResponse.json({ok:true});}",
              "}catch{return NextResponse.json({ok:false},{status:500});}"
          )

          print("Configuration patches applied.")
          PY

      - name: Generate package lock
        working-directory: telegram-integration/GENESIS_4.0_FINAL/source/server
        run: npm install --package-lock-only --ignore-scripts

      - name: Commit prepared changes
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add \
            telegram-integration/GENESIS_4.0_FINAL/source/server/Dockerfile \
            telegram-integration/GENESIS_4.0_FINAL/source/server/.env.example \
            telegram-integration/GENESIS_4.0_FINAL/source/server/docker-compose.yml \
            telegram-integration/GENESIS_4.0_FINAL/source/server/app/api/telegram/webhook/route.ts \
            telegram-integration/GENESIS_4.0_FINAL/source/server/package-lock.json

          git commit -m "Harden GENESIS deployment configuration"

          git push origin "HEAD:${GITHUB_REF_NAME}"

  verify:
    name: Validate and build GENESIS server
    needs: prepare
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: telegram-integration/GENESIS_4.0_FINAL/source/server

    env:
      NODE_ENV: production
      NEXT_TELEMETRY_DISABLED: "1"
      DATABASE_URL: postgresql://genesis:genesis@127.0.0.1:5432/genesis?sslmode=require
      AUTH_SECRET: "genesis-ci-auth-secret-not-for-production-000000000000"
      GENESIS_BOOTSTRAP_TOKEN: "genesis-ci-bootstrap-token-not-for-production-000000"
      APP_URL: https://genesis.example
      GENESIS_APP_ORIGIN: https://genesis.example
      OPENAI_API_KEY: sk-test-placeholder
      OPENAI_MODEL: gpt-5.6
      TELEGRAM_BOT_TOKEN: "123456789:TEST_TOKEN_NOT_REAL"
      TELEGRAM_WEBHOOK_SECRET: "test-webhook-secret"
      TELEGRAM_WEBAPP_URL: https://genesis.example/telegram
      GENESIS_TELEGRAM_ALLOWED_USER_ID: "123456789"
      GENESIS_TELEGRAM_OWNER_USER_ID: "ci-owner"

    steps:
      - name: Checkout updated main
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: telegram-integration/GENESIS_4.0_FINAL/source/server/package-lock.json

      - name: Install locked dependencies
        run: npm ci

      - name: Validate Prisma schema
        run: npx prisma validate

      - name: Generate Prisma client
        run: npx prisma generate

      - name: TypeScript check
        run: npm run typecheck

      - name: Automated tests
        run: npm test

      - name: Production build
        run: npm run build
